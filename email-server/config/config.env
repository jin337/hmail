# ===== WebMail 服务 =====
# 邮件服务器（IMAP/SMTP/hMailServer COM）所在主机
mail.server.host = "127.0.0.1"
# Web 服务监听端口
mail.server.port = 8058
# SMTP 端口
smtp.port = 587
# IMAP 端口
imap.port = 993
# hMailServer 管理员密码
admin.password = "a123456"

# ===== JWT =====
jwt.secret = "email-server-hmail-20260525"
# 令牌有效期（小时）
jwt.life.web.span = 24

# ===== Gin =====
# debug 时路由前缀为 /api，release 时为 /
gin.mode = "debug"
# 可选：显式指定路由前缀（覆盖上面的默认推导）
# api.prefix = "/api"

# ===== 存储 =====
# 静态资源目录（头像、邮件内联图片）
static.dir = "static"
# 联系人 KV 数据库目录
contacts.db.path = "cache/contact_db"
# 单次请求最大上传体积（MB）
server.max.upload = 20
# 跨域白名单，逗号分隔；* 表示允许全部
cors.origins = "*"
